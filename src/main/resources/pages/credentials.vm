<!DOCTYPE html>
<html>
<head>
    <title>Security keys</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
#parse("pages/_style.vm")
    <script type="text/javascript" src="$AUTH_URL/static/webauthn.js" defer></script>
</head>
<body data-auth-url="$AUTH_URL" data-csrf="$!CSRF" data-mode="credentials" data-ctx="">
<div class="page">

    <h2>Security keys of $USER</h2>

    #if ( !$AVAILABLE )
    <div class="reason">Security keys are not available for this account.</div>
    #else
    #if ( $CREDENTIALS.isEmpty() )
    <div class="message">No security keys registered yet.</div>
    #else
    <table class="keys">
        <tr><th>Name</th><th>Type</th><th>Created</th><th>Last used</th><th></th></tr>
        #foreach ( $key in $CREDENTIALS )
        <tr>
            <td>$key.name#if ( $key.current == "yes" ) <span class="muted">(this session)</span>#end<br><span class="muted">AAGUID $key.aaguid</span></td>
            <td>$key.kind</td>
            <td>$key.created</td>
            <td>$key.lastUsed</td>
            <td><input type="button" class="button" value="Remove" data-remove="$key.id" data-last="$LAST_ONE"></td>
        </tr>
        #end
    </table>
    #end

    #if ( $LAST_ONE )
    <div class="row">
        <label><input type="checkbox" id="confirm-last"> I understand that removing my last security key turns off security key login</label>
    </div>
    #end

    <div class="row">
        <label class='form-label' for="key-name">Name for a new key</label>
        <input class='form-input-text' id="key-name" type="text" value="" maxlength="64">
    </div>
    <div class="reason" id="webauthn-error" hidden></div>
    <div class="ok" id="webauthn-status" hidden></div>
    <div class="button-row">
        <input type="button" class="button" id="webauthn-register" value="Add security key">
    </div>
    <p class="muted">Adding or removing a key asks you to confirm with an existing key first.
       Hardware keys need a PIN and use one of their limited discoverable-credential slots.</p>
    #end

    <div class="links">
        <a href="$AUTH_URL/logout">Logout</a>
    </div>
</div>
</body>
</html>
